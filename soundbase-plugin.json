{
  "manifestVersion": 1,
  "id": "harogic",
  "name": "Harogic Spectrum Analyzers",
  "version": "0.1.3",
  "license": "MIT",
  "platforms": [
    "darwin-arm64"
  ],
  "repository": "https://github.com/mbsound/soundbase-plugin-harogic",
  "maintainers": [
    {
      "name": "Matt Bell",
      "email": "matt@mbsound.org"
    }
  ],
  "contract": {
    "core": "1.4",
    "modules": {
      "SpectrumAnalyzer": "1.2"
    }
  },
  "runtime": {
    "type": "node",
    "entrypoint": "main.js"
  },
  "deployment": [
    "managed"
  ],
  "template": {
    "name": "soundbase-plugin-template",
    "version": "1.0.15"
  },
  "products": [
    {
      "deviceTypeId": "plugin:harogic/usb",
      "manufacturer": {
        "id": "harogic",
        "name": "Harogic"
      },
      "model": {
        "id": "usb",
        "name": "USB analyzer",
        "displayName": "Harogic USB Analyzer"
      },
      "family": {
        "id": "harogic",
        "name": "Harogic"
      },
      "capabilities": {
        "spectrumAnalyzer": true
      },
      "traits": {
        "isSpectrumAnalyzer": true
      }
    },
    {
      "deviceTypeId": "plugin:harogic/network",
      "manufacturer": {
        "id": "harogic",
        "name": "Harogic"
      },
      "model": {
        "id": "network",
        "name": "Network analyzer",
        "displayName": "Harogic Network Analyzer"
      },
      "family": {
        "id": "harogic",
        "name": "Harogic"
      },
      "capabilities": {
        "spectrumAnalyzer": true
      },
      "traits": {
        "isSpectrumAnalyzer": true
      }
    }
  ],
  "pluginConfigFields": [
    {
      "id": "addresses",
      "type": "textinput",
      "label": "Network analyzers to look for",
      "help": "Comma-separated addresses or names of Harogic network analyzers that do not announce themselves, e.g. `192.168.1.100, harogic-net1.local`. Add `:port` if the data port is not 5000. Analyzers with the network settings service are found by themselves; USB analyzers always are."
    },
    {
      "id": "mdns",
      "type": "checkbox",
      "label": "Find network analyzers automatically",
      "default": true,
      "help": "Lists every Harogic network analyzer announcing itself (mDNS) on this computer's networks, including one on another subnet reachable over IPv6."
    }
  ],
  "stateKeys": []
}
